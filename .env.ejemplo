# Solo para jugar entre varias compus. En una sola compu no hace falta .env.
#
# Copiar como .env, igual en todas las compus, y poner la IP de la compu que
# corre cada nodo. Dos nodos en la misma compu llevan la misma IP. Nunca
# localhost: dentro de un contenedor, localhost es el propio contenedor.
#
# Si el cluster entero corre en una compu y las demas solo juegan, las tres
# IPs son la de esa compu.
IP_NODO1=192.168.0.11
IP_NODO2=192.168.0.12
IP_NODO3=192.168.0.13

# Opcionales
# PUNTOS=15
# LOG_NIVEL=INFO
